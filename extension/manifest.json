{
  "manifest_version": 3,
  "name": "OpenDM Integration",
  "version": "1.2.0",
  "description": "Send downloads to local OpenDM app: multi-connection acceleration, token auth, optional auto-catch.",
  "permissions": [
    "contextMenus",
    "storage",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
