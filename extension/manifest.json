{
  "manifest_version": 3,
  "name": "OpenDM Integration",
  "version": "2.0.2",
  "key": "",
  "description": "Send downloads to local OpenDM accelerator: multi-connection acceleration, secure Native Messaging auth, and auto-catch.",
  "permissions": [
    "contextMenus",
    "storage",
    "cookies",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
